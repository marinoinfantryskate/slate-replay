# Postgres connection string. Leave unset locally to use the embedded database in .pglite/
DATABASE_URL=

# Public URL used in the share text (defaults to the request origin)
NEXT_PUBLIC_SITE_URL=

# Set to 1 to show Replay today / Next day testing buttons (turn off for real players)
TEST_TOOLS=

# Local testing only: shorten the 5:00 daily timer
SLATE_TIMER_SECONDS=
